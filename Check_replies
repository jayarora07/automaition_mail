START_DATE = "30-Jan-2025"  # Format: DD-MMM-YYYY
END_DATE = "31-Jan-2025"

# 🔹 Function to Fetch Sent Emails List from Google Sheets
def fetch_sent_emails():
    creds = Credentials.from_service_account_file(SERVICE_ACCOUNT_FILE, scopes=SCOPES)
    client = gspread.authorize(creds)
    
    sheet = client.open_by_key(SPREADSHEET_ID).worksheet(SHEET_NAME)
    data = sheet.get_all_records()
    
    df = pd.DataFrame(data)  # Convert to DataFrame
    return set(df["email"])  # Convert email column to a set

# 🔹 Function to Connect to IITB Webmail (IMAP)
def connect_to_imap():
    try:
        mail = imaplib.IMAP4_SSL(IMAP_SERVER, IMAP_PORT)
        mail.login(EMAIL_ID, ACCESS_TOKEN)
        print("✅ Logged in to IITB Webmail successfully!")
        return mail
    except imaplib.IMAP4.error:
        print("❌ Failed to login. Check your credentials.")
        return None

# 🔹 Function to Fetch Replies Within the Date Range
def fetch_replies(mail, sent_email_list):
    mail.select("INBOX")  # Select inbox
    query = f'(SINCE {START_DATE} BEFORE {END_DATE})'  # Date filter
    status, messages = mail.search(None, query)

    if status != "OK":
        print("❌ Error fetching emails.")
        return []

    replied_emails = set()

    # Loop through each email ID
    for num in messages[0].split():
        status, msg_data = mail.fetch(num, "(RFC822)")  # Fetch full email
        if status != "OK":
            continue

        for response_part in msg_data:
            if isinstance(response_part, tuple):
                msg = email.message_from_bytes(response_part[1])  # Parse email
                sender = msg.get("From")

                # Extract only the sender's email
                if sender:
                    sender_email = email.utils.parseaddr(sender)[1]
                    
                    # Check if the sender is in our sent email list
                    if sender_email in sent_email_list:
                        replied_emails.add(sender_email)

    return replied_emails

# 🔹 Main Execution
sent_email_list = fetch_sent_emails()  # Fetch sent emails from Google Sheets
